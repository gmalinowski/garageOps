<% content_for :preheader, t(".preheader") %>
<% reset_url = edit_password_url(@resource, reset_password_token: @token) %>

<p style="margin: 0 0 16px; color: #59694d; font-family: 'Courier New', monospace; font-size: 11px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;"><%= t(".eyebrow") %></p>
<h1 class="mailer-title" style="margin: 0 0 24px; color: #171f1b; font-size: 36px; font-weight: 700; line-height: 1.15; letter-spacing: -1px;"><%= t(".title") %></h1>

<p style="margin: 0 0 16px; overflow-wrap: anywhere;"><%= t(".greeting", email: @resource.email) %></p>
<p style="margin: 0 0 28px; color: #536158;"><%= t(".intro") %></p>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 0 32px;">
  <tr>
    <td bgcolor="#d4fc55" style="border-radius: 6px; mso-padding-alt: 16px 24px;">
      <%= link_to t(".action"), reset_url, style: "display: inline-block; padding: 16px 24px; border: 1px solid #d4fc55; border-radius: 6px; color: #171f1b; font-size: 15px; font-weight: 700; line-height: 20px; text-decoration: none; mso-padding-alt: 0;" %>
    </td>
  </tr>
</table>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin: 0 0 28px;">
  <tr>
    <td bgcolor="#f3f6ef" style="padding: 18px 20px; border-left: 3px solid #b1c78a; color: #536158; font-size: 13px; line-height: 21px;">
      <p style="margin: 0 0 6px; color: #253226; font-weight: 700;"><%= t(".unrequested") %></p>
      <p style="margin: 0;"><%= t(".reassurance") %></p>
    </td>
  </tr>
</table>

<p style="margin: 0 0 8px; color: #667169; font-size: 12px; line-height: 20px;"><%= t(".fallback") %></p>
<p style="margin: 0; font-size: 12px; line-height: 20px; word-break: break-all;">
  <%= link_to reset_url, reset_url, style: "color: #445d32; text-decoration: underline; word-break: break-all;" %>
</p>
