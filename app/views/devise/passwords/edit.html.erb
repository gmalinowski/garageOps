<div class="form-container">
  <h2 class="title">Change your password</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="form__grid">
      <div class="form__field">
        <%= f.label :password, "New password" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
                             aria: { describedby: ("reset-password-hint" if @minimum_password_length) } %>
        <% if @minimum_password_length %>
          <p class="form__hint" id="reset-password-hint"><%= @minimum_password_length %> characters minimum</p>
        <% end %>
      </div>

      <div class="form__field">
        <%= f.label :password_confirmation, "Confirm new password" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>
    </div>

    <div class="form__actions">
      <%= f.submit "Change my password", class: "button button--primary button--lg button--full-width" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
