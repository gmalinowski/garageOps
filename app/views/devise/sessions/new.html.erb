<div class="form-container">
  <h2 class="title"><%= t ".title" %></h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "form" }) do |f| %>
    <div class="form__grid">
      <div class="form__field form__field--full-width">
        <%= f.label :email %>
        <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="form__field">
        <%= f.label :password %>
        <%= f.password_field :password, required: true, autocomplete: "current-password" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form__field form__field--inline">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me %>
        </div>
      <% end %>

      <div class="form__actions">
        <%= f.submit t("actions.sign_in"), class: "button button--primary button--lg button--full-width" %>
      </div>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>