<header class="panel-header">
  <nav class="navbar navbar--panel" aria-label="Application navigation">
    <%= link_to root_path, class: "navbar__brand" do %>
      <span class="navbar__wordmark">
        CAR<span>FORGE</span>
      </span>
    <% end %>

    <details class="navbar-dropdown">
      <summary class="navbar-dropdown__trigger">
        Organizations
        <span class="navbar-dropdown__count"><%= organizations.size %></span>
        <span aria-hidden="true">&#x25bc;</span>
      </summary>

      <div class="navbar-dropdown__menu">
        <p class="navbar-dropdown__label">Your organizations</p>

        <ul data-testid="organization-switcher" class="navbar-dropdown__list">
          <% organizations.each do |org| %>
            <li class="navbar-dropdown__item"><%= org.name %></li>
          <% end %>
        </ul>

        <div class="navbar-dropdown__actions">
          <%= link_to "Manage organizations", organizations_path %>
          <%= link_to "Create organization", new_organization_path %>
        </div>
      </div>
    </details>


    <div class="navbar__links">
      <%= link_to dashboard_path,
            class: "navbar__link",
            aria: { current: ("page" if controller_name == "dashboards") } do %>
        <span class="navbar__index" aria-hidden="true">01 /</span> <%= t ".dashboard" %>
      <% end %>


      <%= link_to destroy_user_session_path,
            class: "navbar__logout",
            data: {
              turbo_method: :delete,
              turbo_confirm: t(".sign_out_confirm")
            } do %>
        <span><%= t ".sign_out" %></span>

        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M14 8l4 4m0 0-4 4m4-4H8m2-7H6.75A1.75 1.75 0 0 0 5 6.75v10.5C5 18.216 5.784 19 6.75 19H10"
          />
        </svg>
      <% end %>
    </div>
  </nav>
</header>
