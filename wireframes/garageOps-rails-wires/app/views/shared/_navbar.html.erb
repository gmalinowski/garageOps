<div class="navbar flex-wrap gap-y-2 bg-base-100 shadow-sm">
  <div class="navbar-start w-auto flex-1">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
        <svg aria-label="Menu" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /> </svg>
      </div>
      <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow">
        <li><%= link_to "Dashboard", dashboard_path %></li>
        <li><%= link_to "Orders", service_orders_path %></li>
        <li><%= link_to "Customers", customers_path %></li>
        <li><%= link_to "Vehicles", vehicles_path %></li>
        <li><%= link_to t("Inventory"), inventory_items_path %></li>
        <li><%= link_to t("Purchase orders"), purchase_orders_path %></li>
        <li><%= link_to "Locations", locations_path, aria: { current: controller_path == "locations" ? "page" : nil } %></li>
      </ul>
    </div>
    <a class="btn btn-ghost text-xl">GarageOps</a>
  </div>

  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal px-1">
      <li><%= link_to t("Dashboard"), dashboard_path %></li>
      <li><%= link_to t("Orders"), service_orders_path %></li>
      <li><%= link_to t("Customers"), customers_path %></li>
      <li><%= link_to t("Vehicles"), vehicles_path %></li>
      <li><%= link_to t("Inventory"), inventory_items_path %></li>
      <li><%= link_to t("Purchase orders"), purchase_orders_path %></li>
      <li><%= link_to "Locations", locations_path, aria: { current: controller_path == "locations" ? "page" : nil } %></li>
    </ul>
  </div>
  <div class="navbar-end w-full gap-3 sm:w-auto">
    <div class="flex min-w-0 flex-1 items-center gap-2 sm:flex-none">
      <label for="current-location" class="text-sm text-base-content/70">Location</label>
      <select id="current-location"
              class="select select-bordered w-full sm:w-48"
              data-controller="location-switcher"
              data-action="change->location-switcher#change"
              aria-describedby="location-preview-hint">
        <option value="all">All Locations</option>
        <option value="central">Central Workshop</option>
        <option value="north">North Workshop</option>
      </select>
      <span id="location-preview-hint" class="sr-only">Sample location selector. The example records are not filtered.</span>
    </div>
    <%= link_to "Settings", settings_root_path, class: "btn" %>
    <%= link_to "Registration", new_registration_path, class: "btn btn-warning" %>
  </div>
</div>
