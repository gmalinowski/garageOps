<% content_for :title, "Create Organization — GarageOps" %>

<div class="mx-auto max-w-2xl">
  <header class="mb-8">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold">Create Organization</h1>
      <span class="badge badge-outline">Wireframe</span>
    </div>
    <p class="mt-3 text-base-content/70">Create your account and set up a shared workspace for your workshop locations.</p>
  </header>

  <%= form_with url: registrations_path, scope: :registration, method: :post, local: true, class: "space-y-6" do |form| %>
    <p class="text-sm text-base-content/60">All fields are required.</p>

    <fieldset class="rounded-box border border-base-300 bg-base-100 p-6">
      <legend class="px-2 text-lg font-semibold">Your Organization</legend>
      <div class="space-y-2">
        <%= form.label :organization_name, "Organization Name", class: "block text-sm font-medium" %>
        <%= form.text_field :organization_name, required: true, autocomplete: "organization", placeholder: "e.g. Northside Auto Service", aria: { describedby: "organization-name-hint" }, class: "input input-bordered w-full" %>
        <p id="organization-name-hint" class="text-sm text-base-content/60">The company or workshop group. You can add individual locations after registration.</p>
      </div>
    </fieldset>

    <fieldset class="rounded-box border border-base-300 bg-base-100 p-6">
      <legend class="px-2 text-lg font-semibold">Your Account</legend>
      <div class="space-y-5">
        <div class="space-y-2">
          <%= form.label :name, "Full Name", class: "block text-sm font-medium" %>
          <%= form.text_field :name, required: true, autocomplete: "name", placeholder: "e.g. Taylor Brooks", class: "input input-bordered w-full" %>
        </div>

        <div class="space-y-2">
          <%= form.label :email, "Email Address", class: "block text-sm font-medium" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "e.g. taylor@example.com", class: "input input-bordered w-full" %>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="space-y-2">
            <%= form.label :password, "Password", class: "block text-sm font-medium" %>
            <%= form.password_field :password, required: true, autocomplete: "new-password", class: "input input-bordered w-full" %>
          </div>
          <div class="space-y-2">
            <%= form.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "input input-bordered w-full" %>
          </div>
        </div>
      </div>
    </fieldset>

    <aside class="rounded-box bg-base-200 p-5">
      <h2 class="font-semibold">Your Organization Administrator Account</h2>
      <p class="mt-2 text-sm text-base-content/70">As the first member, you will receive access to manage the organization, add locations, invite your team and configure permissions.</p>
    </aside>

    <div class="space-y-3">
      <%= form.submit "Create Organization", disabled: true, aria: { describedby: "registration-preview-hint" }, class: "btn btn-primary w-full" %>
      <p id="registration-preview-hint" class="text-center text-sm text-base-content/60">Preview only. Account creation is not available yet.</p>
    </div>
  <% end %>
</div>
